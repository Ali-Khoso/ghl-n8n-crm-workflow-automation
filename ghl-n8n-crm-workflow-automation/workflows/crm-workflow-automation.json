              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "06ba9ef2-2610-4822-9ef5-a595cbb7e47e",
      "name": "9. Enroll Buyer in Deal Blast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "amount": 2
      },
      "id": "609c9d19-cd2a-4119-8f1b-bf9933adeba5",
      "name": "10. Wait (rate limit)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        224,
        160
      ],
      "webhookId": "f90b364e-8e8e-49bd-a9ef-ecaf866b3c4b"
    },
    {
      "parameters": {
        "jsCode": "// Final summary log after loop completes\nconst all = $('6. Refine Buyer List').all();\nreturn [{\n  json: {\n    opportunityId: $('3. Extract Deal Fields').first().json.opportunityId,\n    matched_and_enrolled: all.length,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "d9e3ffb5-873a-44ee-b041-e11768ef8a67",
      "name": "11. Log Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        352
      ]
    }
  ],
